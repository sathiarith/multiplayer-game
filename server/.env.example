# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DB_PATH=./data/game.db

# Generate one with:  node -p "crypto.randomBytes(32).toString('hex')"
SESSION_SECRET=change-me
# Pages allowed to call this API from a browser (comma-separated, no trailing slash)
# To use "Try it out" in /api/docs locally, also add http://127.0.0.1:3001 here.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000