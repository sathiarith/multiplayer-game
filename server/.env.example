# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Generate one with:  node -p "crypto.randomBytes(32).toString('hex')"
SESSION_SECRET=change-me
# Pages allowed to call this API from a browser (comma-separated, no trailing slash).
# The React dev server runs on 5173; /api/docs needs http://127.0.0.1:3001.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001

# Where sessions are stored. Leave it out to keep them in memory (lost on every restart).
REDIS_URL=redis://127.0.0.1:6379

# Experiment only (docs/decisions/0003): "redis" makes every game broadcast reach every server.
# SOCKET_ADAPTER=none

# PostgreSQL (Sprint 8). Local development only; real deployments get this from a secret store.
DATABASE_URL=postgres://game:game-dev-only@127.0.0.1:5432/game