# Caddy gets and renews the HTTPS certificate for {$DOMAIN} by itself,
# redirects http:// to https://, and passes everything to nginx.
{$DOMAIN} {
	encode zstd gzip

	# "defer" applies these after the response comes back from nginx and the
	# server, so they replace any value set further in.
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy web:8080
}